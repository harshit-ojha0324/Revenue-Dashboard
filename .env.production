# Vite bakes VITE_* vars at build time. On Vercel, set VITE_API_URL in the
# project's Environment Variables — a real environment var takes priority over
# this file, so the deployed build points at your Render API.
# This committed default ("/api") only applies to a single-host build.
VITE_API_URL=/api
VITE_ENV=production
VITE_NAME=Sales Dashboard
