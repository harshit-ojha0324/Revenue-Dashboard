# ----------------------------------------------------------------------------
# Copy this file to server/.env and fill in real values.
# Do NOT commit server/.env (it is gitignored).
# ----------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=5001

# Database — local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/sales-dashboard

# Auth
# Generate a strong secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# CORS — the frontend origin(s) allowed to call this API.
# Single origin, or comma-separated list (prod URL + Vercel preview URLs).
CORS_ORIGIN=http://localhost:3000

# Single-host deploys only: set to 'true' to have this server also serve the
# built React app from ../build. Leave unset for the split Render+Vercel setup.
# SERVE_FRONTEND=false

# ----------------------------------------------------------------------------
# Live demo seeder (optional) — inserts evolving fake sales on a schedule so a
# deployed demo keeps changing. Off unless ENABLE_LIVE_SEED=true.
# ----------------------------------------------------------------------------
ENABLE_LIVE_SEED=false
# Cron expression for each tick (default: every 2 minutes)
SEED_CRON=*/2 * * * *
# Sales generated per tick
SEED_BATCH_MIN=1
SEED_BATCH_MAX=4
# Cap on demo sales kept in the DB (oldest trimmed past this)
SEED_MAX_SALES=500
# Demo account that owns generated sales
SEED_DEMO_EMAIL=demo@sales-dashboard.local
# Set to control the demo password (otherwise a random one is logged once)
# SEED_DEMO_PASSWORD=change_me
