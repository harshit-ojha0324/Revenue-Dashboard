# ----------------------------------------------------------------------------
# Frontend (Create React App) environment variables.
# Copy to .env.local for local dev, or set in Vercel's project settings.
# Only variables prefixed with REACT_APP_ are exposed to the browser build.
# ----------------------------------------------------------------------------

# Base URL of the backend API (include the /api suffix).
# Local dev:
REACT_APP_API_URL=http://localhost:5001/api
# Production example (your Render service URL):
# REACT_APP_API_URL=https://your-backend.onrender.com/api
