# ----------------------------------------------------------------------------
# Frontend (Vite) environment variables.
# Copy to .env.local for local dev, or set in Vercel's project settings.
# Only variables prefixed with VITE_ are exposed to the browser build.
# ----------------------------------------------------------------------------

# Base URL of the backend API (include the /api suffix).
# Local dev:
VITE_API_URL=http://localhost:5001/api
# Production example (your Render service URL):
# VITE_API_URL=https://your-backend.onrender.com/api
